# 复制为 .env 后填写；一键部署（./deploy.sh）会自动生成这个文件。
# Copy to .env and fill in; ./deploy.sh generates this file for you.

# 明确指定 release tag 或不可变 digest，升级时手动改；未标记镜像和 latest 会被拒绝。
# An explicit release tag or immutable digest; untagged images and latest are rejected.
PRETENDER_IMAGE=ghcr.io/redstonexs/pretender:v1.0.2

# 所选 LLM 提供商的 API key。/ API key for the LLM provider you chose.
PRETENDER_LLM_API_KEY=

# OneBot 访问令牌，需与 NapCat 中填写的完全一致。
# OneBot access token; NapCat must be configured with the exact same value.
# 生成 / generate: openssl rand -hex 32
ONEBOT_ACCESS_TOKEN=

# NapCat login state and secrets are managed separately by NapCat. Do not add
# QQ passwords or NapCat secret variables to this Pretender environment file.
